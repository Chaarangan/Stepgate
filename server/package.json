{
  "name": "stepgate",
  "version": "0.1.0",
  "description": "Agents can't skip steps: an MCP server that runs gated stepfiles on the connecting client's own model.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agents",
    "stepfile",
    "guardrails"
  ],
  "homepage": "https://github.com/Chaarangan/stepgate#readme",
  "bugs": "https://github.com/Chaarangan/stepgate/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chaarangan/stepgate.git",
    "directory": "server"
  },
  "license": "Apache-2.0",
  "mcpName": "io.github.Chaarangan/stepgate",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "stepgate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts",
    "schema",
    "conformance",
    "stepfiles",
    "docs"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "prepack": "npm run build && cp ../LICENSE ../README.md . && cp -R ../stepfiles . && mkdir -p docs && cp ../docs/stepfile.md docs/",
    "postpack": "rm -rf LICENSE README.md stepfiles docs",
    "demo": "node examples/demo-client.ts",
    "new-stepfile": "node scripts/new-stepfile.ts",
    "check-stepfile": "node scripts/check-stepfile.ts",
    "measure-catalog": "node scripts/measure-catalog.ts",
    "demo:catalog": "node examples/run-catalog.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "json-logic-js": "2.0.5",
    "re2js": "2.8.6",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/json-logic-js": "2.0.8",
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
