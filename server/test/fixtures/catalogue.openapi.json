{
  "openapi": "3.1.0",
  "info": {
    "title": "Catalogue",
    "version": "1"
  },
  "paths": {
    "/items/{id}": {
      "get": {
        "operationId": "getItem",
        "summary": "Fetch one catalogue item.",
        "security": [
          {
            "key": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The item.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "stock": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/flaky": {
      "get": {
        "operationId": "getFlaky",
        "summary": "Answers 503 a configured number of times, then 200.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/revoked": {
      "get": {
        "operationId": "getRevoked",
        "summary": "Always answers as if the grant were revoked.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/basic-items/{id}": {
      "get": {
        "operationId": "getBasicItem",
        "summary": "Fetch one catalogue item with HTTP Basic credentials.",
        "security": [
          {
            "basic": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/formatted/{id}": {
      "get": {
        "operationId": "getFormattedItem",
        "summary": "Fetch one catalogue item; the format must be json.",
        "security": [
          {
            "key": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The item code, such as K-1."
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ]
      }
    },
    "/search": {
      "get": {
        "operationId": "searchItems",
        "summary": "Search the catalogue by tags, choosing the fields returned.",
        "security": [
          {
            "key": []
          }
        ],
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "fields",
            "in": "query",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "/drafts": {
      "post": {
        "operationId": "createDraft",
        "summary": "Store a raw email as a draft.",
        "security": [
          {
            "key": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "message/rfc822": {
              "schema": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "/limited": {
      "get": {
        "operationId": "getLimited",
        "summary": "Rate limited once with Retry-After: 1.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/secondary-limited": {
      "get": {
        "operationId": "getSecondaryLimited",
        "summary": "Rate limited once the way GitHub does, with a 403.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/limited-long": {
      "get": {
        "operationId": "getLongLimited",
        "summary": "Always asks for a two-minute wait.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Report whether the catalogue is up."
      }
    },
    "/redirect-away": {
      "get": {
        "operationId": "getRedirectAway",
        "summary": "Redirects to the same server under another host name.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/redirect-home": {
      "get": {
        "operationId": "getRedirectHome",
        "summary": "Redirects to /items/K-1 on the same host.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/busy": {
      "post": {
        "operationId": "postBusy",
        "summary": "Always answers 503.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/slow": {
      "post": {
        "operationId": "postSlow",
        "summary": "Answers after one second.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/huge": {
      "get": {
        "operationId": "getHuge",
        "summary": "Answers with two megabytes.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/oauth-items/{id}": {
      "get": {
        "operationId": "getOAuthItem",
        "summary": "Fetch one item with an OAuth access token.",
        "security": [
          {
            "oauth": [
              "read:items"
            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/oauth-strict-items/{id}": {
      "get": {
        "operationId": "getStrictOAuthItem",
        "summary": "Fetch one item; the first access token issued is refused as expired.",
        "security": [
          {
            "oauth": [
              "read:items"
            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      },
      "basic": {
        "type": "http",
        "scheme": "basic"
      },
      "oauth": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/authorize",
            "tokenUrl": "https://example.com/token",
            "scopes": {
              "read:items": "Read items."
            }
          }
        }
      }
    }
  }
}
