{
  "openapi": "3.1.0",
  "info": {
    "title": "Catalogue",
    "version": "1"
  },
  "paths": {
    "/items/{id}": {
      "get": {
        "operationId": "getItem",
        "summary": "Fetch one catalogue item.",
        "security": [
          {
            "key": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/flaky": {
      "get": {
        "operationId": "getFlaky",
        "summary": "Answers 503 a configured number of times, then 200.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/revoked": {
      "get": {
        "operationId": "getRevoked",
        "summary": "Always answers as if the grant were revoked.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/basic-items/{id}": {
      "get": {
        "operationId": "getBasicItem",
        "summary": "Fetch one catalogue item with HTTP Basic credentials.",
        "security": [
          {
            "basic": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/formatted/{id}": {
      "get": {
        "operationId": "getFormattedItem",
        "summary": "Fetch one catalogue item; the format must be json.",
        "security": [
          {
            "key": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ]
      }
    },
    "/search": {
      "get": {
        "operationId": "searchItems",
        "summary": "Search the catalogue by tags, choosing the fields returned.",
        "security": [
          {
            "key": []
          }
        ],
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "fields",
            "in": "query",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "/drafts": {
      "post": {
        "operationId": "createDraft",
        "summary": "Store a raw email as a draft.",
        "security": [
          {
            "key": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "message/rfc822": {
              "schema": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "/limited": {
      "get": {
        "operationId": "getLimited",
        "summary": "Rate limited once with Retry-After: 1.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/secondary-limited": {
      "get": {
        "operationId": "getSecondaryLimited",
        "summary": "Rate limited once the way GitHub does, with a 403.",
        "security": [
          {
            "key": []
          }
        ]
      }
    },
    "/limited-long": {
      "get": {
        "operationId": "getLongLimited",
        "summary": "Always asks for a two-minute wait.",
        "security": [
          {
            "key": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      },
      "basic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}
